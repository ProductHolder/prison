	Arrow.TextStrokeTransparency = 0.2
	Arrow.TextScaled = true
	Arrow.Font = Enum.Font.GothamBold
	Arrow.TextTransparency = 1
	Arrow.ZIndex = 20
	Arrow.Parent = ArrowLayer

	ArrowESPObjects[TargetPlayer] = {
		Arrow = Arrow,
		Transparency = 1
	}
end

function SetArrowTransparency(Data, Transparency)
	Data.Transparency = Transparency
	if Data.Arrow then
		Data.Arrow.TextTransparency = Transparency
	end
end

function RemoveArrowESP(TargetPlayer)
	local Data = ArrowESPObjects[TargetPlayer]

	if Data then
		if Data.Arrow then
			Data.Arrow:Destroy()
		end

		ArrowESPObjects[TargetPlayer] = nil
	end
end

function IsArrowTargetVisible(TargetPlayer, Root)
	local Camera = workspace.CurrentCamera

	if not Camera or not Root then
		return false
	end

	local Origin = Camera.CFrame.Position
	local Direction = Root.Position - Origin

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {
		Player.Character,
		TargetPlayer.Character
	}
	Params.IgnoreWater = true

	return workspace:Raycast(Origin, Direction, Params) == nil
end

function UpdateArrowESP(TargetPlayer, Data, DeltaTime)
	local Arrow = Data.Arrow
	local Camera = workspace.CurrentCamera

	if not Arrow or not Arrow.Parent or not Camera or not ArrowESPEnabled then
		if Arrow and Arrow.Parent then
			SetArrowTransparency(Data, 1)
		end
		return
	end

	local Character = TargetPlayer.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Character or not Humanoid or Humanoid.Health <= 0 or not Root then
		SetArrowTransparency(Data, 1)
		return
	end

	if ArrowESPTeamCheck and TargetPlayer.Team == Player.Team then
		SetArrowTransparency(Data, 1)
		return
	end

	local LocalRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
	if not LocalRoot then
		SetArrowTransparency(Data, 1)
		return
	end

	local Distance = (Root.Position - LocalRoot.Position).Magnitude
	if Distance > ArrowESPTrackDistance then
		SetArrowTransparency(Data, 1)
		return
	end

	local Viewport = Camera.ViewportSize
	local Center = Vector2.new(Viewport.X / 2, Viewport.Y / 2)
	local ScreenPosition, OnScreen = Camera:WorldToViewportPoint(Root.Position)
	local Direction

	if OnScreen and ScreenPosition.Z > 0 then
		Direction = Vector2.new(
			ScreenPosition.X - Center.X,
			ScreenPosition.Y - Center.Y
		)
	else
		local Relative = Root.Position - Camera.CFrame.Position
		local X = Relative:Dot(Camera.CFrame.RightVector)
		local Y = Relative:Dot(Camera.CFrame.UpVector)

		if Relative:Dot(Camera.CFrame.LookVector) < 0 then
			X = -X
			Y = -Y
		end

		Direction = Vector2.new(X, -Y)
	end

	if Direction.Magnitude < 0.001 then
		Direction = Vector2.new(0, -1)
	else
		Direction = Direction.Unit
	end

	local Margin = 18
	local HalfWidth = 23
	local HalfHeight = 23
	local EdgeX = Viewport.X / 2 + Direction.X * (Viewport.X / 2 - Margin)
	local EdgeY = Viewport.Y / 2 + Direction.Y * (Viewport.Y / 2 - Margin)

	local Position = Vector2.new(
		math.clamp(EdgeX, Margin + HalfWidth, Viewport.X - Margin - HalfWidth),
		math.clamp(EdgeY, Margin + HalfHeight, Viewport.Y - Margin - HalfHeight)
	)

	Arrow.Position = UDim2.fromOffset(Position.X, Position.Y)
	Arrow.Size = UDim2.fromOffset(46, 46)
	Arrow.Rotation = math.deg(math.atan2(Direction.Y, Direction.X))

	Arrow.TextColor3 = ArrowESPColor

	local LookingAtTarget = false
	if OnScreen and ScreenPosition.Z > 0 then
		local CameraDirection = Camera.CFrame.LookVector
		local TargetDirection = (Root.Position - Camera.CFrame.Position).Unit
		LookingAtTarget = CameraDirection:Dot(TargetDirection) >= 0.965
	end

	local TargetVisible = IsArrowTargetVisible(TargetPlayer, Root)
	local ShouldFade = LookingAtTarget and OnScreen and TargetVisible
	local TargetTransparency = ShouldFade and 1 or 0

	Data.Transparency +=
		(TargetTransparency - Data.Transparency) *
		math.clamp(DeltaTime * ArrowESPFadeSpeed, 0, 1)

	SetArrowTransparency(Data, Data.Transparency)
end

