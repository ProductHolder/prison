function IsVisible(TargetCharacter, TargetPart)
	if not WallCheck then
		return true
	end

	local Camera = workspace.CurrentCamera

	if not Camera then
		return false
	end

	local Origin = Camera.CFrame.Position
	local Direction = TargetPart.Position - Origin

	local Parameters = RaycastParams.new()
	Parameters.FilterType = Enum.RaycastFilterType.Exclude
	Parameters.FilterDescendantsInstances = {
		Player.Character,
		TargetCharacter
	}
	Parameters.IgnoreWater = true

	local Result = workspace:Raycast(
		Origin,
		Direction,
		Parameters
	)

	return Result == nil
end

function IsValidTarget(TargetPlayer)
	if TargetPlayer == Player then
		return false
	end

	local Character = TargetPlayer.Character

	if not Character then
		return false
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local Head = Character:FindFirstChild("Head")

	if not Humanoid or Humanoid.Health <= 0 or not Head then
		return false
	end

	if TeamCheck and TargetPlayer.Team == Player.Team then
		return false
	end

	if not IsVisible(Character, Head) then
		return false
	end

	return true
end

function GetClosestTarget()
	local Camera = workspace.CurrentCamera

	if not Camera then
		return nil
	end

	local MousePosition = UserInputService:GetMouseLocation()
	local ClosestPlayer = nil
	local ClosestDistance = math.huge

	for _, TargetPlayer in ipairs(Players:GetPlayers()) do
		if IsValidTarget(TargetPlayer) then
			local Character = TargetPlayer.Character
			local Head = Character and Character:FindFirstChild("Head")

			if Head then
				local ScreenPosition, OnScreen =
					Camera:WorldToViewportPoint(Head.Position)

				if OnScreen and ScreenPosition.Z > 0 then
					local Distance = (
						Vector2.new(ScreenPosition.X, ScreenPosition.Y) -
						Vector2.new(MousePosition.X, MousePosition.Y)
					).Magnitude

					if RadiusCheck then
						if Distance <= AimbotRadius and Distance < ClosestDistance then
							ClosestDistance = Distance
							ClosestPlayer = TargetPlayer
						end
					elseif Distance < ClosestDistance then
						ClosestDistance = Distance
						ClosestPlayer = TargetPlayer
					end
				end
			end
		end
	end

	return ClosestPlayer
end

function AimCameraAtTarget(TargetPosition)
	local Camera = workspace.CurrentCamera

	if not Camera then
		return
	end

	local CameraPosition = Camera.CFrame.Position

	local TargetCFrame = CFrame.lookAt(
		CameraPosition,
		TargetPosition
	)

	local Smoothness = math.clamp(
		AimbotSmoothness,
		0.01,
		1
	)

	Camera.CFrame = Camera.CFrame:Lerp(
		TargetCFrame,
		Smoothness
	)
end

table.insert(
	Connections,
	RunService.RenderStepped:Connect(function()
		if Unloaded then
			return
		end

		local MousePosition = UserInputService:GetMouseLocation()

		if FOVCircle then
			FOVCircle.Position = UDim2.fromOffset(
				MousePosition.X,
				MousePosition.Y
			)

			FOVCircle.Size = UDim2.fromOffset(
				AimbotRadius * 2,
				AimbotRadius * 2
			)

			FOVCircle.Visible =
				AimbotEnabled
				and ShowFOV
				and RadiusCheck
		end

		if not AimbotEnabled or not AimbotHolding then
			CurrentTarget = nil
			return
		end

		if not CurrentTarget or not IsValidTarget(CurrentTarget) then
			CurrentTarget = GetClosestTarget()
		end

		if not CurrentTarget then
			return
		end

		local Character = CurrentTarget.Character
		local Head = Character and Character:FindFirstChild("Head")
		local Camera = workspace.CurrentCamera

		if not Head or not Camera then
			CurrentTarget = nil
			return
		end

		local ScreenPosition, OnScreen =
			Camera:WorldToViewportPoint(Head.Position)

		if not OnScreen or ScreenPosition.Z <= 0 then
			CurrentTarget = nil
			return
		end

		local TargetScreenPosition = Vector2.new(
			ScreenPosition.X,
			ScreenPosition.Y
		)

		if RadiusCheck then
			local Distance = (
				TargetScreenPosition -
				UserInputService:GetMouseLocation()
			).Magnitude

			if Distance > AimbotRadius then
				CurrentTarget = nil
				return
			end
		end

		AimCameraAtTarget(Head.Position)
	end)
)

