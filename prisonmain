function SelectTab(Name)
	local Page = Pages[Name]

	if not Page then
		return
	end

	if CurrentTab == Name then
		return
	end

	CurrentTab = Name

	for TabName, Button in pairs(TabButtons) do
		local Active = TabName == Name

		TweenService:Create(Button, TweenInfo.new(0.2), {
			BackgroundColor3 = Active and Theme.Accent or Theme.Sidebar,
			TextColor3 = Active and Color3.new(1, 1, 1) or Theme.SubText
		}):Play()
	end

	for PageName, OtherPage in pairs(Pages) do
		if PageName == Name then
			OtherPage.Visible = true
			OtherPage.Position = UDim2.fromOffset(18, 0)

			TweenService:Create(
				OtherPage,
				TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
				{
					Position = UDim2.fromOffset(0, 0)
				}
			):Play()
		else
			OtherPage.Visible = false
		end
	end
end

