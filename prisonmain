				Outline.Visible = false
				Fill.Visible = false
				HealthBack.Visible = false
				Health.Visible = false
				Name.Visible = false
				Distance.Visible = false
				continue
			end

			Outline.Visible = false
			Fill.Visible = false

			local Character = TargetPlayer.Character
			local Humanoid =
				Character
				and Character:FindFirstChildOfClass("Humanoid")

			local Root =
				Character
				and Character:FindFirstChild("HumanoidRootPart")

			if not Character
				or not Humanoid
				or Humanoid.Health <= 0
				or not Root then

				Outline.Visible = false
				Fill.Visible = false
				HealthBack.Visible = false
				Health.Visible = false
				Name.Visible = false
				Distance.Visible = false
				continue
			end

			if ESPTeamCheck and TargetPlayer.Team == Player.Team then
				Outline.Visible = false
				Fill.Visible = false
				HealthBack.Visible = false
				Health.Visible = false
				Name.Visible = false
				Distance.Visible = false
				continue
			end

			if LocalRoot
				and (Root.Position - LocalRoot.Position).Magnitude > ESPMaxDistance then

				Outline.Visible = false
				Fill.Visible = false
				HealthBack.Visible = false
				Health.Visible = false
				Name.Visible = false
				Distance.Visible = false
				continue
			end

			local CF, Size = Character:GetBoundingBox()

			local MinX = math.huge
			local MinY = math.huge
			local MaxX = -math.huge
			local MaxY = -math.huge
			local Found = false

			for X = -1, 1, 2 do
				for Y = -1, 1, 2 do
					for Z = -1, 1, 2 do
						local Point = CF:PointToWorldSpace(
							Vector3.new(
								Size.X / 2 * X,
								Size.Y / 2 * Y,
								Size.Z / 2 * Z
							)
						)

						local Screen, Visible =
							Camera:WorldToViewportPoint(Point)

						if Visible and Screen.Z > 0 then
							Found = true
							MinX = math.min(MinX, Screen.X)
							MinY = math.min(MinY, Screen.Y)
							MaxX = math.max(MaxX, Screen.X)
							MaxY = math.max(MaxY, Screen.Y)
						end
					end
				end
			end

			if not Found then
				Outline.Visible = false
				Fill.Visible = false
				HealthBack.Visible = false
				Health.Visible = false
				Name.Visible = false
				Distance.Visible = false
				continue
			end

			local Position = Vector2.new(MinX, MinY)
			local BoxSize = Vector2.new(
				MaxX - MinX,
				MaxY - MinY
			)

			Outline.Position = Position
			Outline.Size = BoxSize
			Outline.Thickness = ESPThickness
			Outline.Color = ESPColor
			Outline.Visible = BoxESPEnabled

			Fill.Position = Position
			Fill.Size = BoxSize
			Fill.Color = ESPColor
			Fill.Transparency = ESPFillTransparency
			Fill.Visible = BoxESPEnabled and ESPFilled

			local HealthPercent = math.clamp(
				Humanoid.Health / math.max(Humanoid.MaxHealth, 1),
				0,
				1
			)

			local HealthColor

			if HealthPercent > 0.6 then
				HealthColor = Color3.fromRGB(70, 220, 90)
			elseif HealthPercent > 0.3 then
				HealthColor = Color3.fromRGB(245, 205, 55)
			else
				HealthColor = Color3.fromRGB(235, 60, 60)
			end

			local HealthX = Position.X - 6
			local HealthTop = Position.Y
			local HealthBottom = Position.Y + BoxSize.Y

			HealthBack.From = Vector2.new(
				HealthX,
				HealthTop
			)
			HealthBack.To = Vector2.new(
				HealthX,
				HealthBottom
			)
			HealthBack.Thickness = 4
			HealthBack.Color = Color3.fromRGB(20, 20, 20)
			HealthBack.Visible = ESPHealthbar

			local HealthY = HealthBottom - (BoxSize.Y * HealthPercent)

			Health.From = Vector2.new(
				HealthX,
				HealthBottom
			)
			Health.To = Vector2.new(
				HealthX,
				HealthY
			)
			Health.Thickness = 4
			Health.Color = HealthColor
			Health.Visible = ESPHealthbar and HealthPercent > 0

			Name.Text = TargetPlayer.DisplayName
			Name.Position = Vector2.new(
				Position.X + BoxSize.X / 2,
				Position.Y - 16
			)
			Name.Visible = ESPName

			if LocalRoot then
				local DistanceStuds = math.floor(
					(Root.Position - LocalRoot.Position).Magnitude + 0.5
				)

				Distance.Text = tostring(DistanceStuds) .. " studs"
				Distance.Position = Vector2.new(
					Position.X + BoxSize.X / 2,
					Position.Y + BoxSize.Y + 2
				)
				Distance.Visible = ESPDistance
			else
				Distance.Visible = false
			end
		end
	end)
)

