MP5Enabled = false
MP5BulletTracersEnabled = false
MP5InfiniteAmmoEnabled = false
MP5TracerThickness = 0.15
MP5TracerOpacity = 0.3
MP5TracerColor = Color3.fromRGB(255, 255, 0)
MP5Connections = {}
ActiveMP5 = nil
MP5Firing = false
MP5FeatureGroup = {}
MP5TracerSettings = {}

function DisconnectMP5Connections()
	for _, Connection in ipairs(MP5Connections) do
		pcall(function()
			Connection:Disconnect()
		end)
	end

	table.clear(MP5Connections)
	ActiveMP5 = nil
	MP5Firing = false
end

function FindLocalMP5()
	local Character = Player.Character

	if Character then
		local Tool = Character:FindFirstChild("MP5")
		if Tool and Tool:IsA("Tool") then
			return Tool
		end
	end

	local Backpack = Player:FindFirstChildOfClass("Backpack")

	if Backpack then
		local Tool = Backpack:FindFirstChild("MP5")
		if Tool and Tool:IsA("Tool") then
			return Tool
		end
	end

	return nil
end

function ApplyMP5InfiniteAmmo(MP5)
	if not MP5InfiniteAmmoEnabled or not MP5 then
		return
	end

	pcall(function()
		MP5:SetAttribute("MaxAmmo", 100)
		MP5:SetAttribute("CurrentAmmo", 100)
		MP5:SetAttribute("Local_CurrentAmmo", 100)
	end)
end

function CreateMP5Tracer(MP5)
	if not MP5Enabled or not MP5BulletTracersEnabled then
		return
	end

	if not MP5 or not MP5:IsDescendantOf(game) then
		return
	end

	if FindLocalMP5() ~= MP5 then
		return
	end

	if MP5:GetAttribute("IsReloading") == true then
		return
	end

	local Muzzle = MP5:FindFirstChild("Muzzle", true)

	if not Muzzle or not Muzzle:IsA("BasePart") then
		return
	end

	local Mouse = Player:GetMouse()
	local StartPosition = Muzzle.Position
	local EndPosition = Mouse.Hit.Position
	local Direction = EndPosition - StartPosition
	local Distance = Direction.Magnitude

	if Distance <= 0 then
		return
	end

	local Tracer = Instance.new("Part")
	Tracer.Name = "SourceX_MP5Tracer"
	Tracer.Anchored = true
	Tracer.CanCollide = false
	Tracer.CanQuery = false
	Tracer.CanTouch = false
	Tracer.CastShadow = false
	Tracer.Material = Enum.Material.Neon
	Tracer.Color = MP5TracerColor
	Tracer.Transparency = math.clamp(MP5TracerOpacity, 0, 1)
	Tracer.Size = Vector3.new(MP5TracerThickness, MP5TracerThickness, Distance)
	Tracer.CFrame = CFrame.lookAt(StartPosition, EndPosition) * CFrame.new(0, 0, -Distance / 2)
	Tracer.Parent = workspace

	local Fade = TweenService:Create(
		Tracer,
		TweenInfo.new(1, Enum.EasingStyle.Linear),
		{Transparency = 1}
	)

	Fade:Play()

	Fade.Completed:Connect(function()
		if Tracer and Tracer.Parent then
			Tracer:Destroy()
		end
	end)
end

function StopMP5TracerLoop()
	MP5Firing = false
end

function StartMP5TracerLoop(MP5)
	if MP5Firing then
		return
	end

	MP5Firing = true

	task.spawn(function()
		while MP5Firing and MP5Enabled and MP5BulletTracersEnabled do
			if not MP5 or not MP5:IsDescendantOf(game) then
				break
			end

			if FindLocalMP5() ~= MP5 then
				break
			end

			if MP5:GetAttribute("IsReloading") == true then
				break
			end

			CreateMP5Tracer(MP5)

			local FireRate = MP5:GetAttribute("FireRate")

			if typeof(FireRate) ~= "number" or FireRate <= 0 then
				FireRate = 0.1
			end

			task.wait(FireRate)
		end

		MP5Firing = false
	end)
end

function SetupLocalMP5(MP5)
	if not MP5 or not MP5:IsA("Tool") then
		return
	end

	if ActiveMP5 == MP5 then
		ApplyMP5InfiniteAmmo(MP5)
		return
	end

	DisconnectMP5Connections()
	ActiveMP5 = MP5

	table.insert(MP5Connections, MP5.Activated:Connect(function()
		if not MP5Enabled or not MP5BulletTracersEnabled then
			return
		end

		if MP5:GetAttribute("IsReloading") == true then
			return
		end

		StartMP5TracerLoop(MP5)
	end))

	table.insert(MP5Connections, MP5.Deactivated:Connect(function()
		StopMP5TracerLoop()
	end))

	table.insert(MP5Connections, MP5:GetAttributeChangedSignal("IsReloading"):Connect(function()
		if MP5:GetAttribute("IsReloading") == true then
			StopMP5TracerLoop()
		end
	end))

	table.insert(MP5Connections, MP5:GetAttributeChangedSignal("CurrentAmmo"):Connect(function()
		if MP5InfiniteAmmoEnabled then
			task.defer(function()
				ApplyMP5InfiniteAmmo(MP5)
			end)
		end
	end))

	table.insert(MP5Connections, MP5:GetAttributeChangedSignal("Local_CurrentAmmo"):Connect(function()
		if MP5InfiniteAmmoEnabled then
			task.defer(function()
				ApplyMP5InfiniteAmmo(MP5)
			end)
		end
	end))

	table.insert(MP5Connections, MP5:GetAttributeChangedSignal("MaxAmmo"):Connect(function()
		if MP5InfiniteAmmoEnabled then
			task.defer(function()
				ApplyMP5InfiniteAmmo(MP5)
			end)
		end
	end))

	table.insert(MP5Connections, MP5.AncestryChanged:Connect(function()
		if not MP5:IsDescendantOf(game) then
			StopMP5TracerLoop()
			if ActiveMP5 == MP5 then
				ActiveMP5 = nil
			end
		end
	end))

	ApplyMP5InfiniteAmmo(MP5)
end

function RefreshLocalMP5()
	local MP5 = FindLocalMP5()
	if MP5 then
		SetupLocalMP5(MP5)
	end
end

