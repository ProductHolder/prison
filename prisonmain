function CreateESP(TargetPlayer)
	if TargetPlayer == Player or ESPBoxes[TargetPlayer] then
		return
	end

	local Ok, Outline = pcall(function()
		return Drawing.new("Square")
	end)

	local OkFill, Fill = pcall(function()
		return Drawing.new("Square")
	end)

	local OkHealthBack, HealthBack = pcall(function()
		return Drawing.new("Line")
	end)

	local OkHealth, Health = pcall(function()
		return Drawing.new("Line")
	end)

	local OkName, Name = pcall(function()
		return Drawing.new("Text")
	end)

	local OkDistance, Distance = pcall(function()
		return Drawing.new("Text")
	end)

	if not Ok or not Outline
		or not OkFill or not Fill
		or not OkHealthBack or not HealthBack
		or not OkHealth or not Health
		or not OkName or not Name
		or not OkDistance or not Distance then

		for _, Object in ipairs({
			Outline,
			Fill,
			HealthBack,
			Health,
			Name,
			Distance
		}) do
			if Object then
				pcall(function()
