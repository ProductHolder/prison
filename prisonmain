RagebotSettings = {}
AntiAimSettings = {}

function RestoreAntiAim()
	local Character = Player.Character
	local Humanoid =
		Character
		and Character:FindFirstChildOfClass("Humanoid")

	if Humanoid then
		Humanoid.AutoRotate = true
	end

	RageState.Humanoid = nil
	RageState.BaseYaw = nil
	RageState.JitterDirection = 1
	RageState.LastJitterTime = 0
end

function StopAntiAim()
	RageState.AntiAimEnabled = false

	if RageState.Connection then
		RageState.Connection:Disconnect()
		RageState.Connection = nil
	end

	RestoreAntiAim()
end

function StartAntiAim()
	if not RageState.Enabled or Unloaded then
		return
	end

	local Character = Player.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Character or not Humanoid or not Root then
		return
	end

	RageState.AntiAimEnabled = true
	RageState.Humanoid = Humanoid
	Humanoid.AutoRotate = false

	RageState.JitterDirection = 1
	RageState.LastJitterTime = tick()

	if RageState.Connection then
		RageState.Connection:Disconnect()
	end

	RageState.Connection = RunService.RenderStepped:Connect(function()
		if Unloaded or not RageState.Enabled or not RageState.AntiAimEnabled then
			return
		end

		local CurrentCharacter = Player.Character
		local CurrentHumanoid =
			CurrentCharacter
			and CurrentCharacter:FindFirstChildOfClass("Humanoid")

		local CurrentRoot =
			CurrentCharacter
			and CurrentCharacter:FindFirstChild("HumanoidRootPart")

		local Camera = workspace.CurrentCamera

		if not CurrentHumanoid or not CurrentRoot or not Camera then
			return
		end

		CurrentHumanoid.AutoRotate = false

		local LookVector = Camera.CFrame.LookVector

		local CameraYaw = math.atan2(
			-LookVector.X,
			-LookVector.Z
		)

		local Now = tick()

		if RageState.JitterSpeed > 0 then
			local Interval = 0.5 / RageState.JitterSpeed

			if Now - RageState.LastJitterTime >= Interval then
				RageState.JitterDirection = -RageState.JitterDirection
				RageState.LastJitterTime = Now
			end
		else
			RageState.JitterDirection = 1
		end

		local JitterOffset = 0

		if RageState.JitterSpeed > 0 then
			JitterOffset = math.rad(45) * RageState.JitterDirection
		end

		local FinalYaw =
			CameraYaw
			+ math.rad(RageState.Yaw)
			+ JitterOffset

		CurrentRoot.CFrame =
			CFrame.new(CurrentRoot.Position)
			* CFrame.Angles(0, FinalYaw, 0)
	end)
end

function StopRagebot()
	StopAntiAim()
end

