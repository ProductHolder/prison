BulletTracersEnabled = false
TracerLifetime = 1
TracerThickness = 0.15
TracerColor = Color3.fromRGB(255, 255, 0)
TracerMaterial = Enum.Material.Neon
TracerFade = true

function CreateTracer(StartPosition, EndPosition)
	local Direction = EndPosition - StartPosition
	local Distance = Direction.Magnitude

	if Distance <= 0 then
		return
	end

	local Tracer = Instance.new("Part")
	Tracer.Name = "SourceXBulletTracer"
	Tracer.Anchored = true
	Tracer.CanCollide = false
	Tracer.CanTouch = false
	Tracer.CanQuery = false
	Tracer.CastShadow = false
	Tracer.Material = TracerMaterial
	Tracer.Color = TracerColor
	Tracer.Transparency = TracerFade and 0.15 or 0
	Tracer.Size = Vector3.new(
		TracerThickness,
		TracerThickness,
		Distance
	)

	Tracer.CFrame =
		CFrame.lookAt(StartPosition, EndPosition)
		* CFrame.new(0, 0, -Distance / 2)

	Tracer.Parent = workspace

	if TracerFade then
		local Tween = TweenService:Create(
			Tracer,
			TweenInfo.new(
				TracerLifetime,
				Enum.EasingStyle.Linear
			),
			{
				Transparency = 1
			}
		)

		Tween:Play()

		Tween.Completed:Connect(function()
			if Tracer.Parent then
				Tracer:Destroy()
			end
		end)
	else
		task.delay(TracerLifetime, function()
			if Tracer.Parent then
				Tracer:Destroy()
			end
		end)
	end
end

